{
  "name": "@lvce-editor/rpc-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "format": "prettier --write .",
    "lint": "eslint . && knip --no-config-hints",
